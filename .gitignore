# ==========================================
# RailSync AI - Git Ignore
# ==========================================

# ---------- Node / Frontend ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- Machine Learning ----------
*.pkl
*.joblib
*.onnx

# ---------- Logs ----------
*.log

# ---------- IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/

# ---------- Operating System ----------
.DS_Store
Thumbs.db

# ---------- Temporary ----------
*.tmp
*.temp
*.swp